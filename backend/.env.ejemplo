# Esto es solo una plantilla de ejemplo de como deberia ser el .env. la original no se subio al repositorio para mantener privada la 
#clave del proyecto MongoDB Atlas. Para poder correr el proyecto, se debe crear un archivo .env en la carpeta backend con los 
#valores reales de la URI y el nombre de la base de datos.

# aca iria la URI completa de Atlas. Mantener las opciones provistas por Atlas.
MONGODB_URI=

# Aca iria el nombre exacto de la base de datos que se usara en el proyecto y que ya se encuentra creada en Atlas.
MONGODB_DB=

# aca iria el puerto en el que se ejecutara el backend. Por defecto usamos 3000.
# no hace falta que sea el mismo que usa el frontend porque cada uno se ejecuta por separado.
# si cambiamos este puerto, tambien debemos actualizar la direccion que usa el frontend para conectarse al backend.
# no dejarlo vacio porque con el codigo actual se elegiria un puerto automaticamente.
PORT=3000
